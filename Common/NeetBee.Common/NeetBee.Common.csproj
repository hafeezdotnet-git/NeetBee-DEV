<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code shared by the NEET BEE backend services (Services/*):
    - Logging: the Serilog setup every service uses (AddNeetBeeLogging).
    - Notifications: the NotificationService contract (types, channels, template data, request body)
      and the HTTP client other services use to send notifications through it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NeetBee.Common</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
