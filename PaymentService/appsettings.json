{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "LogFiles": {
    "Directory": "logs",
    "RetainedFileCount": 14
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5003" }
    }
  },
  "ConnectionStrings": {
    "NeetBee": "Server=localhost;Database=NEET_BEE;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "NeetBee",
      "Audience": "NeetBeeClients",
      "SigningKey": ""
    }
  },
  "Payments": {
    "Gateway": "Fake",
    "Currency": "INR",
    "MaxAmount": 100000,
    "Razorpay": {
      "KeyId": ""
    }
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:5002/",
    "ApiKey": ""
  }
}
