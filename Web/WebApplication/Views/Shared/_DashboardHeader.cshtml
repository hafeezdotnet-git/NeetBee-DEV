@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var page = controller + "/" + action;
}
<header class="nb-topbar">
    <button class="nb-icon-btn nb-menu-btn" type="button" data-nb-menu aria-label="Open navigation menu" aria-expanded="false" aria-controls="nb-sidebar">☰</button>

    <a class="nb-brand" asp-controller="Dashboard" asp-action="Index" aria-label="NEET Bee dashboard">
        <img src="/img/neetbee-logo.png" alt="NEET BEE logo" width="112" height="58">
        <div>
            <div class="nb-brand-title">NEET Bee<sup>®</sup></div>
            <div class="nb-brand-subtitle">Your NEET Preparation Companion</div>
        </div>
    </a>

    <button class="nb-icon-btn nb-kebab-btn" type="button" data-nb-actions aria-label="Show search and account options" aria-expanded="false" aria-controls="nb-header-search nb-header-actions">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
    </button>

    <nav class="nb-topnav" aria-label="Primary">
        <a class="@(page == "Dashboard/Index" ? "active" : null)" asp-controller="Dashboard" asp-action="Index"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/dashboard.svg')" aria-hidden="true"></span>Home</a>
        <a class="@(page == "Study/Courses" ? "active" : null)" asp-controller="Study" asp-action="Courses"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/book.svg')" aria-hidden="true"></span>Courses</a>
        <a class="@(page == "Study/McqPractice" ? "active" : null)" asp-controller="Study" asp-action="McqPractice"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/target.svg')" aria-hidden="true"></span>Practice</a>
        <a class="@(page == "Study/MockTests" ? "active" : null)" asp-controller="Study" asp-action="MockTests"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/clipboard.svg')" aria-hidden="true"></span>Mock Tests</a>
        <details class="nb-tools-menu">
            <summary><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/atom.svg')" aria-hidden="true"></span>Study Tools ▾</summary>
            <div class="nb-tools-list">
                <a asp-controller="Study" asp-action="PreviousYearPapers">Previous Year Papers</a>
                <a asp-controller="Study" asp-action="AudioLearning">Audio Learning</a>
                <a asp-controller="Study" asp-action="VoiceQa">Voice Q&amp;A</a>
            </div>
        </details>
    </nav>

    <div class="nb-search" id="nb-header-search" role="search">
        <span class="nb-icon" style="--nb-icon:url('/assets/neetbee/search.svg')" aria-hidden="true"></span>
        <input id="site-search" class="nb-search-input" type="search" placeholder="Search courses, topics, MCQs..." aria-label="Search courses, topics and MCQs">
    </div>

    <div class="nb-header-actions" id="nb-header-actions">
        <div class="nb-notify-wrap">
            <button class="nb-icon-btn" id="nb-notify-btn" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="nb-notify-panel">
                <span class="nb-icon" style="--nb-icon:url('/assets/neetbee/bell.svg')" aria-hidden="true"></span>
            </button>
            <div class="nb-popover" id="nb-notify-panel" hidden>
                <h3>Notifications</h3>
                <p class="nb-muted">You're all caught up.</p>
            </div>
        </div>

        <button class="nb-icon-btn theme-toggle" type="button" aria-label="Switch to light mode" title="Switch to light mode" aria-pressed="true">
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 15.3A8.5 8.5 0 0 1 8.7 3.8 8.5 8.5 0 1 0 20.2 15.3Z"/></svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
        </button>

        <button class="nb-icon-btn install-app-button" type="button" data-install-app aria-label="Install NEET BEE app" title="Install NEET BEE app" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4"/><path d="M5 15v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"/></svg>
        </button>

        <span class="nb-profile" tabindex="0">
            <span class="nb-avatar"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/user.svg')" aria-hidden="true"></span></span>
            <span class="nb-profile-name">Hi, @User.Identity?.Name</span>
        </span>

        <a class="nb-icon-btn nb-settings-btn@(page == "Study/Settings" ? " active" : "")" asp-controller="Study" asp-action="Settings" aria-label="Settings" title="Settings"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/settings.svg')" aria-hidden="true"></span></a>

        <form class="nb-logout-form" asp-controller="Account" asp-action="Logout" method="post">
            <button class="nb-logout" type="submit" data-loading="Signing out"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/logout.svg')" aria-hidden="true"></span>Log out</button>
        </form>
    </div>
</header>
