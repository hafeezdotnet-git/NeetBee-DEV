@{
    ViewData["Title"] = "Account created";
    var userName = ViewData["UserName"] as string;
}

<section class="auth-card auth-success" aria-labelledby="registered-title">
    <div class="auth-success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h1 id="registered-title">Account created!</h1>
    <p class="sub" role="status">
        @if (!string.IsNullOrEmpty(userName))
        {
            <text>Welcome, <strong>@userName</strong>. </text>
        }
        Your <span class="auth-brand"><span class="auth-brand-neet">NEET</span> <span class="auth-brand-bee">BEE</span></span> account is ready. Sign in to start your NEET preparation.
    </p>

    <a class="btn-primary" asp-action="Login">Sign in</a>
</section>
