@model NeetBee.Web.Models.VoiceQaPage
@{
    ViewData["Title"] = "Voice Q&A";
    Layout = "_DashboardLayout";

    // Page numbers to show: first, last, current ±1, with gaps marked as 0 (rendered as "…").
    var pages = new List<int>();
    for (var p = 1; p <= Model.TotalPages; p++)
    {
        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 1)
        {
            if (pages.Count > 0 && p - pages[^1] > 1) pages.Add(0);
            pages.Add(p);
        }
    }
    var progressPercent = Model.TotalPages == 0 ? 0 : Model.Page * 100 / Model.TotalPages;

    var hasPager = !Model.Filter.ShowAll && Model.TotalQuestions > NeetBee.Web.Models.VoiceQaFilter.SizeOptions[0];

    // The pager, shown above and below the questions. "where" ("top" / "bottom") keeps element ids unique.
    async Task Pager(string where)
    {

        var atFirst = Model.Page == 1;
        var atLast = Model.Page == Model.TotalPages;
        <nav class="vqa-pg vqa-pg-@where" aria-label="@(where == "top" ? "Question pages (top)" : "Question pages")">
            <div class="vqa-pg-nav">
                @{ await PagerLink(1, atFirst, "First page", "M11 17l-5-5 5-5M18 17l-5-5 5-5"); }
                @{ await PagerLink(Model.Page - 1, atFirst, "Previous page", "M15 18l-6-6 6-6"); }
                <span class="vqa-pg-pages">
                    @foreach (var p in pages)
                    {
                        if (p == 0)
                        {
                            <span class="vqa-pg-gap" aria-hidden="true">…</span>
                        }
                        else if (p == Model.Page)
                        {
                            <span class="vqa-pg-num is-current" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="vqa-pg-num" asp-action="VoiceQa" asp-all-route-data="@Model.Filter.RouteValues(p)" aria-label="Page @p">@p</a>
                        }
                    }
                </span>
                @{ await PagerLink(Model.Page + 1, atLast, "Next page", "M9 18l6-6-6-6"); }
                @{ await PagerLink(Model.TotalPages, atLast, "Last page", "M13 17l5-5-5-5M6 17l5-5-5-5"); }
            </div>

            <span class="vqa-pg-sep" aria-hidden="true"></span>

            @* "5 / 108": type a page number and press Enter to jump there. *@
            <form class="vqa-pg-jump" method="get" asp-action="VoiceQa">
                @if (Model.Filter.Subject is not null) { <input type="hidden" name="subject" value="@Model.Filter.Subject"> }
                @if (Model.Filter.Year is not null) { <input type="hidden" name="year" value="@Model.Filter.Year"> }
                <input type="hidden" name="size" value="@Model.PageSize">
                <label for="vqa-goto-page-@where" class="visually-hidden">Go to page (1 to @Model.TotalPages)</label>
                <input type="number" id="vqa-goto-page-@where" name="page" min="1" max="@Model.TotalPages" value="@Model.Page" inputmode="numeric" required>
                <span class="vqa-pg-total">/ @Model.TotalPages</span>
                <button type="submit" class="visually-hidden">Go</button>
            </form>

            <span class="vqa-pg-sep" aria-hidden="true"></span>

            <form class="vqa-pg-rows" method="get" asp-action="VoiceQa">
                @if (Model.Filter.Subject is not null) { <input type="hidden" name="subject" value="@Model.Filter.Subject"> }
                @if (Model.Filter.Year is not null) { <input type="hidden" name="year" value="@Model.Filter.Year"> }
                <label for="vqa-rows-@where">Rows:</label>
                <span class="vqa-select-wrap">
                    <select id="vqa-rows-@where" class="vqa-rows-select" name="size" data-first="@Model.FirstNumber">
                        @foreach (var option in NeetBee.Web.Models.VoiceQaFilter.SizeOptions)
                        {
                            <option value="@option" selected="@(option == Model.PageSize)">@option</option>
                        }
                    </select>
                </span>
                <noscript><button type="submit">Apply</button></noscript>
            </form>
        </nav>
        
    }

    // « ‹ › » buttons: a link, or a disabled button when already at that end.
    async Task PagerLink(int target, bool disabled, string label, string iconPath)
    {
        var icon = $"<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"{iconPath}\"/></svg>";
        if (disabled)
        {
            <span class="vqa-pg-btn is-disabled" aria-disabled="true" title="@label">@Html.Raw(icon)<span class="visually-hidden">@label</span></span>
        }
        else
        {
            <a class="vqa-pg-btn" asp-action="VoiceQa" asp-all-route-data="@Model.Filter.RouteValues(target)" title="@label">@Html.Raw(icon)<span class="visually-hidden">@label</span></a>
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="/css/neetbee-voice-qa.css?v=11">
}

@Html.AntiForgeryToken()

<section class="vqa" id="vqa"
         data-azure="@(Model.AzureSpeechEnabled ? "true" : "false")"
         data-speak-url="@Url.Action("Speak", "Study")"
         data-progress-url="@Url.Action("VoiceQaProgress", "Study")"
         data-reset-url="@Url.Action("VoiceQaProgressReset", "Study")"
         data-subject="@Model.Filter.Subject"
         data-year="@Model.Filter.Year"
         data-total="@Model.TotalQuestions"
         data-page-size="@(Model.Filter.ShowAll ? Math.Max(1, Model.TotalQuestions) : Model.PageSize)"
         data-last-heard="@(Model.Resume?.LastHeardNumber)"
         data-resume-page="@(Model.Resume?.NextPage)">

    <header class="vqa-head">
        <div>
            <h1>Voice <span>Q&amp;A</span></h1>
            <p>Listen to NEET questions and answers in an Indian English voice.</p>
        </div>
        <div class="vqa-head-tools">
            <span class="vqa-engine" id="vqa-engine" title="Speech engine in use">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/></svg>
                <span id="vqa-engine-label">@(Model.AzureSpeechEnabled ? "Azure neural voice" : "Device voice")</span>
            </span>

            <div class="vqa-menu">
                <button type="button" class="vqa-kebab" id="vqa-menu-btn" aria-label="Voice, speed and reading settings" aria-haspopup="true" aria-expanded="false" aria-controls="vqa-menu-panel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
                </button>
                <div class="vqa-menu-panel" id="vqa-menu-panel" role="group" aria-label="Voice, speed and reading" hidden>
                    <label class="vqa-field">
                        <span>Voice</span>
                        <span class="vqa-select-wrap vqa-select-flag">
                            <span class="vqa-flag" aria-hidden="true"></span>
                            <select id="vqa-voice" aria-label="Voice">
                                @foreach (var voice in Model.Voices)
                                {
                                    <option value="@voice.AzureName" data-hint="@voice.BrowserHint">@voice.DisplayName</option>
                                }
                            </select>
                        </span>
                    </label>
                    <label class="vqa-field">
                        <span>Speed</span>
                        <span class="vqa-select-wrap">
                            <select id="vqa-rate" aria-label="Speed">
                                <option value="0.75">0.75x (Slow)</option>
                                <option value="1" selected>1x (Normal)</option>
                                <option value="1.2">1.2x (Fast)</option>
                                <option value="1.5">1.5x (Faster)</option>
                            </select>
                        </span>
                    </label>
                    <label class="vqa-field">
                        <span>Read</span>
                        <span class="vqa-select-wrap">
                            <select id="vqa-mode" aria-label="What to read">
                                <option value="full" selected>Question, options and answer</option>
                                <option value="qa">Question and answer (skip options)</option>
                                <option value="answer">Answers only</option>
                            </select>
                        </span>
                    </label>
                </div>
            </div>
        </div>
    </header>

    <div class="vqa-panel">
        <form class="vqa-filters" id="vqa-filters" method="get" asp-action="VoiceQa" aria-label="Filter questions">
            <div class="vqa-filter-row">
                <fieldset class="vqa-subjects">
                    <legend>Subject</legend>
                    <div class="vqa-chips">
                        <label class="vqa-chip"><input type="radio" name="subject" value="" @(Model.Filter.Subject is null ? "checked" : null)><span>All subjects</span></label>
                        @foreach (var subject in Model.Subjects)
                        {
                            <label class="vqa-chip vqa-chip-@subject.ToLowerInvariant()"><input type="radio" name="subject" value="@subject" @(Model.Filter.Subject == subject ? "checked" : null)><span>@subject</span></label>
                        }
                    </div>
                </fieldset>
                <label class="vqa-field vqa-subject-field">
                    <span>Subject</span>
                    <span class="vqa-select-wrap">
                        @* No name: on phones this mirrors the subject buttons above, which carry the value. *@
                        <select id="vqa-subject" aria-label="Subject">
                            <option value="" selected="@(Model.Filter.Subject is null)">All subjects</option>
                            @foreach (var subject in Model.Subjects)
                            {
                                <option value="@subject" selected="@(Model.Filter.Subject == subject)">@subject</option>
                            }
                        </select>
                    </span>
                </label>
                <label class="vqa-field vqa-year-field">
                    <span>Year</span>
                    <span class="vqa-select-wrap">
                        <select name="year" id="vqa-year" aria-label="Question paper year">
                            <option value="">All years</option>
                            @foreach (var y in Model.Years)
                            {
                                <option value="@y" selected="@(Model.Filter.Year == y)">NEET @y</option>
                            }
                        </select>
                    </span>
                </label>
                @if (Model.Filter.ShowAll)
                {
                    <input type="hidden" name="all" value="true">
                }
                @if (Model.PageSize != NeetBee.Web.Models.VoiceQaFilter.DefaultSize)
                {
                    <input type="hidden" name="size" value="@Model.PageSize">
                }
                <button type="submit" class="vqa-apply" id="vqa-apply">Apply</button>
            </div>
        </form>

        <button type="button" class="vqa-play" id="vqa-play">
            <span class="vqa-play-icon" aria-hidden="true">
                <svg class="i-play" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg class="i-pause" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
            </span>
            <span class="vqa-play-text">
                <strong id="vqa-play-title">Play</strong>
                <small id="vqa-status" aria-live="polite" data-idle="Press to play @Model.Filter.Describe() questions">Press to play @Model.Filter.Describe() questions</small>
            </span>
            <span class="vqa-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        </button>

        <div class="vqa-controls" id="vqa-controls" role="group" aria-label="Playback controls">
            <button type="button" class="vqa-ctl vqa-ctl-skip" id="vqa-prev" title="Previous question">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg><span class="vqa-ctl-label">Previous</span>
            </button>
            <button type="button" class="vqa-ctl" id="vqa-pause" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>Pause
            </button>
            <button type="button" class="vqa-ctl" id="vqa-resume" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>Resume
            </button>
            <button type="button" class="vqa-ctl vqa-ctl-stop" id="vqa-stop" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>Stop
            </button>
            <button type="button" class="vqa-ctl vqa-ctl-skip" id="vqa-next" title="Next question">
                <span class="vqa-ctl-label">Next</span><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg>
            </button>
        </div>

        <div class="vqa-repeat-row">
            <label for="vqa-repeat">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg>
                Repeat each question
            </label>
            <span class="vqa-select-wrap">
                <select id="vqa-repeat" aria-describedby="vqa-repeat-help">
                    @for (var r = 1; r <= 5; r++)
                    {
                        <option value="@r" selected="@(r == 1)">@(r == 1 ? "1 time" : $"{r} times")</option>
                    }
                </select>
            </span>
            <span class="visually-hidden" id="vqa-repeat-help">How many times each question and answer is read before moving on.</span>
        </div>

        <div class="vqa-progress" id="vqa-progress">
            <div class="vqa-progress-text">
                <span>@(Model.Filter.ShowAll ? "All questions" : $"Page {Model.Page} of {Model.TotalPages}") · @Model.Filter.Describe()</span>
                <span>
                    @Model.FirstNumber – @Model.LastNumber of @Model.TotalQuestions
                    @if (Model.TotalQuestions > Model.PageSize || Model.Filter.ShowAll)
                    {
                        <a class="vqa-showall" asp-action="VoiceQa" asp-all-route-data="@((Model.Filter with { ShowAll = !Model.Filter.ShowAll }).RouteValues())">@(Model.Filter.ShowAll ? "Show pages" : "Show all")</a>
                    }
                </span>
            </div>
            <div class="vqa-bar" role="progressbar" aria-label="Page progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progressPercent">
                <span style="width:@(progressPercent)%"></span>
            </div>
        </div>
    </div>

    <div class="vqa-mini" id="vqa-mini" role="region" aria-label="Playback controls" hidden>
        <button type="button" class="vqa-mini-main" id="vqa-mini-play" aria-label="Play">
            <svg class="i-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <svg class="i-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
        </button>
        <span class="vqa-mini-text">
            <strong id="vqa-mini-title">Play</strong>
            <small id="vqa-mini-status"></small>
        </span>
        <span class="vqa-mini-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="vqa-mini-actions">
            <button type="button" class="vqa-mini-btn" id="vqa-mini-prev" title="Previous question">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z"/></svg><span class="visually-hidden">Previous question</span>
            </button>
            <button type="button" class="vqa-mini-btn" id="vqa-mini-pause" title="Pause" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg><span class="visually-hidden">Pause</span>
            </button>
            <button type="button" class="vqa-mini-btn" id="vqa-mini-resume" title="Resume" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg><span class="visually-hidden">Resume</span>
            </button>
            <button type="button" class="vqa-mini-btn vqa-mini-stop" id="vqa-mini-stop" title="Stop" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg><span class="visually-hidden">Stop</span>
            </button>
            <button type="button" class="vqa-mini-btn" id="vqa-mini-next" title="Next question">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM4 5v14l11-7z"/></svg><span class="visually-hidden">Next question</span>
            </button>
        </span>
    </div>

    @if (Model.Resume is { } resume && Model.TotalQuestions > 0)
    {
        <div class="vqa-resume" id="vqa-resume-box">
            <span class="vqa-resume-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <p id="vqa-resume-text">
                @if (resume.NextNumber is int next)
                {
                    <text>You have listened up to question <strong>@resume.LastHeardNumber</strong> of @resume.Total.</text>
                }
                else
                {
                    <text>You have listened to all <strong>@resume.Total</strong> questions.</text>
                }
            </p>
            <div class="vqa-resume-actions">
                @if (resume.NextNumber is int nextNumber)
                {
                    <button type="button" class="vqa-resume-btn" id="vqa-continue">Continue from question @nextNumber</button>
                }
                <button type="button" class="vqa-resume-link" id="vqa-restart">Start from question 1</button>
            </div>
        </div>
    }

    <p class="vqa-note" id="vqa-note" hidden></p>

    @if (Model.LoadError is not null)
    {
        <div class="vqa-empty" role="alert">
            <strong>@Model.LoadError</strong>
        </div>
    }
    else if (Model.TotalQuestions == 0)
    {
        <div class="vqa-empty">
            <strong>No questions for @Model.Filter.Describe() yet.</strong>
            <p>Choose another subject or year, or <a asp-action="VoiceQa">show all questions</a>.</p>
        </div>
    }

    <div class="vqa-pager-top" id="vqa-pager-top">
        @if (hasPager)
        {
            <div class="vqa-pager-top-bar">
                <span class="vqa-pager-top-summary">Page @Model.Page of @Model.TotalPages · @Model.FirstNumber – @Model.LastNumber of @Model.TotalQuestions</span>
                <button type="button" class="vqa-pager-top-toggle" data-pager-toggle aria-expanded="true" aria-controls="vqa-pager-top-body">
                    <span class="vqa-when-open">Hide paging</span><span class="vqa-when-closed">Show paging</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
                </button>
            </div>
            <div class="vqa-pager-top-body" id="vqa-pager-top-body">
                @{ await Pager("top"); }
            </div>
        }
    </div>

    <ol class="vqa-list" id="vqa-list" data-page="@Model.Page" data-total-pages="@Model.TotalPages">
        @foreach (var q in Model.Questions)
        {
            var first = q == Model.Questions[0];
            var bodyId = $"vqa-body-{q.Number}";
            <li class="vqa-card@(first ? " is-open" : null)" data-q="@q.Number" data-id="@q.Id">
                <div class="vqa-card-head">
                    <span class="vqa-num" aria-hidden="true">@q.Number</span>
                    <h2 class="vqa-q" data-seg="q@(q.Number)" data-say="Question @q.Number. @q.Text">
                        <button type="button" class="vqa-toggle" aria-expanded="@(first ? "true" : "false")" aria-controls="@bodyId">
                            <span class="vqa-tag vqa-tag-@q.Subject.ToLowerInvariant()">@q.Subject · NEET @q.Year@(string.IsNullOrEmpty(q.Topic) ? null : " · " + q.Topic)</span>
                            <span class="visually-hidden">Question @q.Number: </span>@q.Text
                        </button>
                    </h2>
                    <button type="button" class="vqa-icon-btn vqa-bookmark" aria-pressed="false" aria-label="Bookmark question @q.Number" data-bookmark="@q.Id">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg>
                    </button>
                    <button type="button" class="vqa-icon-btn vqa-chevron" tabindex="-1" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                </div>

                <div class="vqa-card-body" id="@bodyId" @(first ? null : "hidden")>
                    <ul class="vqa-options">
                        @for (var i = 0; i < q.Options.Count; i++)
                        {
                            var letter = ((char)('A' + i)).ToString();
                            <li class="vqa-option@(i == q.CorrectIndex ? " is-correct" : null)" data-seg="q@(q.Number)-o@(i)" data-say="Option @letter. @q.Options[i]">
                                <span class="vqa-letter">@letter</span><span>@q.Options[i]</span>
                            </li>
                        }
                    </ul>

                    <div class="vqa-answer" data-seg="q@(q.Number)-a" data-say="The answer is option @q.CorrectLetter, @q.CorrectText. @q.Explanation">
                        <span class="vqa-answer-icon" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
                        </span>
                        <div>
                            <strong>Answer: @q.CorrectText</strong>
                            <p>Explanation: @q.Explanation</p>
                        </div>
                    </div>

                    <div class="vqa-card-actions">
                        <button type="button" class="vqa-speak" data-speak="question" data-q="@q.Number">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
                            Speak Question
                        </button>
                        <button type="button" class="vqa-speak vqa-speak-answer" data-speak="answer" data-q="@q.Number">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
                            Speak Answer
                        </button>
                    </div>
                </div>
            </li>
        }
    </ol>

    <div id="vqa-pager-wrap">
        @if (hasPager) { await Pager("bottom"); }
    </div>
</section>

@section Scripts {
    <script src="/js/voice-qa.js?v=9"></script>
}
