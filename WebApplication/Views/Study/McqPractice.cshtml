@{
    ViewData["Title"] = "MCQ Practice";
    Layout = "_DashboardLayout";
}

<section class="page-hero"><span class="eyebrow">SMALL STEPS. BIG PROGRESS.</span><h1>MCQ <em>Practice Zone</em></h1><p>Choose a subject, answer sample questions, and build confidence one question at a time.</p></section><section class="content quiz-layout"><aside class="quiz-side"><h3>Choose a subject</h3><button class="subject-select active" data-topic="Biology">🌿 Biology</button><button class="subject-select" data-topic="Chemistry">⚗ Chemistry</button><button class="subject-select" data-topic="Physics">⚛ Physics</button><div class="progress-track"><span id="progress-fill"></span></div><small id="progress-label">Question 1 of 5</small></aside><section class="quiz"><div class="quiz-top"><small id="quiz-subject">BIOLOGY • SAMPLE MCQ</small><b id="question-count">QUESTION 1 / 5</b></div><h2 id="question-text"></h2><div id="answer-options" class="answers"></div><p id="answer-feedback" aria-live="polite"></p><div class="quiz-controls"><button class="btn pale" id="reset-quiz">Restart</button><button class="btn cta" id="next-question" disabled>Next Question →</button></div></section></section>

@section Scripts {
    <script src="/js/study.js"></script>
}
