@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var page = controller + "/" + action;
}
<!doctype html>
<html lang="en">
<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="/css/neetbee-dashboard.css?v=3">
    <link rel="stylesheet" href="/css/neetbee-dashboard-overrides.css?v=6">
    <link id="nb-light-css" rel="stylesheet" href="/css/neetbee-dashboard-light.css?v=6" disabled>
    <link rel="stylesheet" href="/css/neetbee-ai-assistant.css?v=1">
</head>
<body class="dashboard-body neetbee-theme">
    <a class="skip-link" href="#dashboard-content">Skip to main content</a>

    <partial name="_DashboardHeader" />

    <div class="nb-layout">
        <partial name="_DashboardSidebar" />

        <main id="dashboard-content" class="nb-main">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />

    <div class="nb-backdrop" id="nb-backdrop" hidden></div>

    <nav class="nb-bottom-nav" aria-label="Quick navigation">
        <a class="@(page == "Study/AudioLearning" ? "active" : null)" asp-controller="Study" asp-action="AudioLearning"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/headphones.svg')" aria-hidden="true"></span>Audio Learning</a>
        <a class="@(page == "Study/Pricing" ? "active" : null)" asp-controller="Study" asp-action="Pricing"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/crown.svg')" aria-hidden="true"></span>Premium Plans</a>
        <a class="@(page == "Study/Courses" ? "active" : null)" asp-controller="Study" asp-action="Courses"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/book.svg')" aria-hidden="true"></span>Courses</a>
        <a class="@(page == "Study/McqPractice" ? "active" : null)" asp-controller="Study" asp-action="McqPractice"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/target.svg')" aria-hidden="true"></span>MCQ Practice</a>
    </nav>

    <div class="toast" role="status" aria-live="polite"></div>

    <partial name="_AiAssistant" />

    <script src="/js/dashboard.js?v=6"></script>
    <script src="/js/ai-assistant.js?v=1"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
