@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var page = controller + "/" + action;
}
<aside id="nb-sidebar" class="nb-sidebar" aria-label="Dashboard navigation">
    <div class="nb-sidebar-head">
        <strong>Menu</strong>
        <button class="nb-icon-btn" type="button" data-nb-close aria-label="Close menu">&times;</button>
    </div>
    <nav class="nb-nav">
        <a class="@(page == "Dashboard/Index" ? "active" : null)" asp-controller="Dashboard" asp-action="Index"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/dashboard.svg')" aria-hidden="true"></span>Dashboard</a>

        <div class="nb-nav-group">Learning</div>
        <a class="@(page == "Study/Courses" ? "active" : null)" asp-controller="Study" asp-action="Courses"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/book.svg')" aria-hidden="true"></span>Courses</a>
        <a class="@(page == "Study/PreviousYearPapers" ? "active" : null)" asp-controller="Study" asp-action="PreviousYearPapers"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/file.svg')" aria-hidden="true"></span>Previous Year Papers</a>
        <a class="@(page == "Study/McqPractice" ? "active" : null)" asp-controller="Study" asp-action="McqPractice"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/target.svg')" aria-hidden="true"></span>MCQ Practice</a>
        <a class="@(page == "Study/MockTests" ? "active" : null)" asp-controller="Study" asp-action="MockTests"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/clipboard.svg')" aria-hidden="true"></span>Mock Tests</a>
        <a class="@(page == "Study/AudioLearning" ? "active" : null)" asp-controller="Study" asp-action="AudioLearning"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/headphones.svg')" aria-hidden="true"></span>Audio Learning</a>

        <div class="nb-nav-group">My Progress</div>
        <a class="@(page == "Study/Performance" ? "active" : null)" asp-controller="Study" asp-action="Performance"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/chart.svg')" aria-hidden="true"></span>Performance</a>
        <a class="@(page == "Study/SavedQuestions" ? "active" : null)" asp-controller="Study" asp-action="SavedQuestions"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/bookmark.svg')" aria-hidden="true"></span>Saved Questions</a>
        <a class="@(page == "Study/Achievements" ? "active" : null)" asp-controller="Study" asp-action="Achievements"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/trophy.svg')" aria-hidden="true"></span>Achievements</a>

        <div class="nb-nav-group">Account</div>
        <a class="@(page == "Study/Pricing" ? "active" : null)" asp-controller="Study" asp-action="Pricing"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/crown.svg')" aria-hidden="true"></span>Plans &amp; Pricing</a>
        <a class="@(page == "Study/Settings" ? "active" : null)" asp-controller="Study" asp-action="Settings"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/settings.svg')" aria-hidden="true"></span>Settings</a>
        <a class="@(page == "Study/HelpSupport" ? "active" : null)" asp-controller="Study" asp-action="HelpSupport"><span class="nb-icon" style="--nb-icon:url('/assets/neetbee/help.svg')" aria-hidden="true"></span>Help &amp; Support</a>
    </nav>
</aside>
