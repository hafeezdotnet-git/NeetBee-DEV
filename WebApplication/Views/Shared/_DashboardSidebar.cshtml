@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var page = controller + "/" + action;

    // Sidebar menu: group heading (null = none), controller, action, icon file, name, one-line description.
    var groups = new (string? Heading, (string Controller, string Action, string Icon, string Name, string Description)[] Items)[]
    {
        (null, new[]
        {
            ("Dashboard", "Index", "dashboard", "Dashboard", "Your progress at a glance"),
        }),
        ("Learning", new[]
        {
            ("Study", "Courses", "book", "Courses", "Subject-wise lessons"),
            ("Study", "PreviousYearPapers", "file", "Previous Year Papers", "Practise past NEET papers"),
            ("Study", "McqPractice", "target", "MCQ Practice", "Quick topic-wise questions"),
            ("Study", "MockTests", "clipboard", "Mock Tests", "Full-length timed exams"),
            ("Study", "AudioLearning", "headphones", "Audio Learning", "Listen to lessons on the go"),
            ("Study", "VoiceQa", "headphones", "Voice Q&A", "Questions read aloud to you"),
        }),
        ("My Progress", new[]
        {
            ("Study", "Performance", "chart", "Performance", "Scores and weak areas"),
            ("Study", "SavedQuestions", "bookmark", "Saved Questions", "Questions you bookmarked"),
            ("Study", "Achievements", "trophy", "Achievements", "Badges and milestones"),
        }),
        ("Account", new[]
        {
            ("Study", "Pricing", "crown", "Plans & Pricing", "Upgrade your plan"),
            ("Study", "Settings", "settings", "Settings", "Profile and preferences"),
            ("Study", "HelpSupport", "help", "Help & Support", "FAQs and contact us"),
        }),
    };
}
<aside id="nb-sidebar" class="nb-sidebar" aria-label="Dashboard navigation">
    <div class="nb-sidebar-head">
        <strong>Menu</strong>
        <button class="nb-icon-btn" type="button" data-nb-close aria-label="Close menu">&times;</button>
    </div>
    <nav class="nb-nav">
        @foreach (var group in groups)
        {
            if (group.Heading is not null)
            {
                <div class="nb-nav-group">@group.Heading</div>
            }
            foreach (var item in group.Items)
            {
                var isActive = page == $"{item.Controller}/{item.Action}";
                <a class="nb-nav-item@(isActive ? " active" : null)" asp-controller="@item.Controller" asp-action="@item.Action" aria-current="@(isActive ? "page" : null)">
                    <span class="nb-icon" style="--nb-icon:url('/assets/neetbee/@(item.Icon).svg')" aria-hidden="true"></span>
                    <span class="nb-nav-text">
                        <span class="nb-nav-name">@item.Name</span>
                        <span class="nb-nav-desc">@item.Description</span>
                    </span>
                </a>
            }
        }
    </nav>
</aside>
