{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "LogFiles": {
    "Directory": "logs",
    "RetainedFileCount": 14
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5100" }
    }
  },
  "Site": {
    "RootPath": "."
  },
  "Gateway": {
    "BaseUrl": "http://localhost:5000"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Session": {
    "SecureCookies": false
  }
}
