{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5000" }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5100",
      "http://127.0.0.1:5100",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Authentication": {
    "Auth_type": "TokenBased",
    "Jwt": {
      "Issuer": "NeetBee",
      "Audience": "NeetBeeClients",
      "SigningKey": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-me": {
        "ClusterId": "authentication",
        "Match": { "Path": "/api/auth/me" },
        "AuthorizationPolicy": "Default"
      },
      "auth-public": {
        "ClusterId": "authentication",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "AuthorizationPolicy": "Anonymous"
      }
    },
    "Clusters": {
      "authentication": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5001/" }
        }
      }
    }
  }
}
