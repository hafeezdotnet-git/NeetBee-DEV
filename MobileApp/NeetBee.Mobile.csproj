<Project Sdk="Microsoft.NET.Sdk">

	<!--
		NEET BEE mobile app: a thin .NET MAUI shell that shows the NEET BEE website in a full-screen WebView.
		The website address is read from appsettings.json (embedded below), see README.md.

		Targets the newest MAUI the installed .NET SDK supports (.NET 11). net8.0 MAUI is out of support
		and cannot be built with the .NET 11 SDK and its android/ios workloads.
	-->
	<PropertyGroup>
		<TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>NeetBee.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>NEET BEE</ApplicationTitle>

		<!-- App Identifier (Android package name / iOS bundle id). Change before publishing to the stores. -->
		<ApplicationId>com.neetbee.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon: the NEET BEE bee (from the website logo) on a white background. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" ForegroundScale="0.7" Color="#FFFFFF" />

		<!-- Splash Screen: the full NEET BEE logo on white. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#FFFFFF" BaseSize="256,131" />

		<!-- Images (logo shown on the "no internet" screen) -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\neetbee_logo.png" BaseSize="256,131" />
	</ItemGroup>

	<ItemGroup>
		<!-- App settings (start URL). Embedded so it ships inside the app; read by AppSettings.cs. -->
		<EmbeddedResource Include="appsettings.json" LogicalName="NeetBee.Mobile.appsettings.json" />
		<None Remove="appsettings.json" />
		<Content Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
	</ItemGroup>

</Project>
