{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "LogFiles": {
    "Directory": "logs",
    "RetainedFileCount": 14
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5001" }
    }
  },
  "NotificationService": {
    "BaseUrl": "http://localhost:5002/",
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "NeetBee": "Server=localhost;Database=NEET_BEE;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  },
  "Authentication": {
    "Auth_type": "TokenBased",
    "Jwt": {
      "Issuer": "NeetBee",
      "Audience": "NeetBeeClients",
      "SigningKey": "",
      "AccessTokenExpiryMinutes": 15,
      "RefreshTokenExpiryDays": 30
    }
  }
}
