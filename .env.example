# Replace these placeholders before starting the containers.
AUTHENTICATION_JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters
NOTIFICATION_API_KEY=replace-with-a-random-secret-at-least-32-characters
SA_PASSWORD=replace-with-a-strong-sql-sa-password

# Compose uses SA_PASSWORD for the SQL Server container and the API connection string.
