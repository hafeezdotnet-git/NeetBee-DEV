@model VerifyCodeViewModel
@{
    ViewData["Title"] = "Enter code";
}

<section class="auth-card" aria-labelledby="verify-title">
    <h1 id="verify-title">Enter your code</h1>
    <p class="sub">We sent a 6-digit code to <strong>@Model.Email</strong>. It expires in 10 minutes.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

    <form asp-action="VerifyCode" method="post" novalidate>
        <input asp-for="Email" type="hidden" />

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" autofocus />
            <span asp-validation-for="Code" class="field-error"></span>
        </div>

        <button type="submit" class="btn-primary">Verify and sign in</button>
    </form>

    <p class="auth-switch">Didn't get the code? <a asp-action="EmailCode">Send a new code</a></p>
</section>
