@model LoginViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign in";

    // Where the "Download the App!" QR code points. Set App:DownloadUrl to the Play Store / App Store link.
    var configuredAppUrl = Configuration["App:DownloadUrl"];
    var appDownloadUrl = !string.IsNullOrWhiteSpace(configuredAppUrl)
        ? configuredAppUrl
        : $"{Context.Request.Scheme}://{Context.Request.Host}/";
}

<section class="auth-card" aria-labelledby="login-title">
    <h1 id="login-title">Welcome back</h1>
    <p class="sub">Sign in to continue your NEET preparation.</p>

    @if (TempData["Message"] is string message)
    {
        <p class="alert alert-success" role="status">@message</p>
    }

    @if (TempData["Error"] is string googleError)
    {
        <p class="alert alert-error" role="alert">@googleError</p>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

    <form asp-action="Login" method="post" novalidate>
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <div class="pw-wrap">
                <input asp-for="Password" type="password" autocomplete="current-password" />
                <button type="button" class="pw-toggle" data-target="Password" aria-label="Show password" aria-pressed="false">
                    <svg class="icon-show" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="icon-hide" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn-primary">Sign in</button>
    </form>

    <div class="divider"><span>or</span></div>

    <p class="auth-register">Don't have an account? <a asp-action="Register">Register for free</a></p>
    <a class="btn-google" asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl">
        <svg class="g-logo" viewBox="0 0 48 48" width="24" height="24" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Sign-In with Google
    </a>

    <p class="auth-alt"><a asp-action="EmailCode">Use an email code instead</a></p>
</section>

@* "Download the App!" card, bottom-left. The QR code opens App:DownloadUrl (appsettings);
   until a store link is set it opens this website. Hidden on phones, where scanning makes no sense. *@
<aside class="app-promo" id="app-promo" aria-label="Get the NEET Bee app" hidden>
    <button type="button" class="app-promo-close" id="app-promo-close" aria-label="Close">&times;</button>
    <span class="app-promo-badge">Download the App!</span>
    <a class="app-promo-qr" href="@appDownloadUrl" target="_blank" rel="noopener" aria-label="Scan this QR code or open the NEET Bee app link">
        <span id="app-promo-qr" data-url="@appDownloadUrl"></span>
    </a>
</aside>

<script>
    document.querySelectorAll('.pw-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = document.getElementById(btn.getAttribute('data-target'));
            var showing = input.type === 'password';
            input.type = showing ? 'text' : 'password';
            btn.setAttribute('aria-pressed', showing ? 'true' : 'false');
            btn.setAttribute('aria-label', showing ? 'Hide password' : 'Show password');
        });
    });
</script>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        // Draws the QR code and shows the card (closed cards stay closed for this browser session).
        (function () {
            var card = document.getElementById('app-promo');
            var holder = document.getElementById('app-promo-qr');
            if (!card || !holder || typeof QRCode === 'undefined') return;   // library unavailable: leave hidden
            try { if (sessionStorage.getItem('neetbee-app-promo') === 'closed') return; } catch (e) { }

            new QRCode(holder, {
                text: holder.getAttribute('data-url'),
                width: 132,
                height: 132,
                colorDark: '#000000',
                colorLight: '#ffffff',
                correctLevel: QRCode.CorrectLevel.M
            });
            card.hidden = false;

            document.getElementById('app-promo-close').addEventListener('click', function () {
                card.hidden = true;
                try { sessionStorage.setItem('neetbee-app-promo', 'closed'); } catch (e) { }
            });
        })();
    </script>
}
